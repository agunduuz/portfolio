# ── Public (istemci paketine girer, gizli değildir) ─────────────────────────
# lib/env.ts tarafından modül seviyesinde doğrulanır; eksikse build patlar.
NEXT_PUBLIC_SITE_URL=https://anilgunduz.dev
NEXT_PUBLIC_CAREER_START=2021-09-01T00:00:00Z

# ── Sunucu sırları (asla NEXT_PUBLIC_ öneki alma) ───────────────────────────
# lib/env.server.ts tarafından ilk kullanımda doğrulanır.

# Faz 3 — GitHub verisi
# Fine-grained PAT, YALNIZCA "Metadata: Read" izniyle.
GITHUB_TOKEN=
GITHUB_USERNAME=agunduuz
# GitHub push webhook'unun x-hub-signature-256 imzası için.
# Değiştirirsen GitHub webhook ayarında da güncelle, yoksa sessizce 401 döner.
GITHUB_WEBHOOK_SECRET=

# Faz 6 — Formlar
RESEND_API_KEY=
# İş teklifi ve abonelik bildirimlerinin gideceği adres.
CONTACT_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
