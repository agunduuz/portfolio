# ── Public (istemci paketine girer, gizli değildir) ─────────────────────────
# lib/env.ts tarafından modül seviyesinde doğrulanır; eksikse build patlar.
NEXT_PUBLIC_SITE_URL=https://anilgunduz.dev
NEXT_PUBLIC_CAREER_START=2021-09-01T00:00:00Z

# ── Sunucu sırları (asla NEXT_PUBLIC_ öneki alma) ───────────────────────────
# lib/env.server.ts bunları FAZ FAZ AYRI doğrular: Faz 3 çalışmak için Faz 6'nın
# anahtarlarını istemez. Aşağıdaki grubu boş bırakırsan yalnızca o özellik kapalı
# kalır, uygulama ayağa kalkar.

# Faz 3 — GitHub verisi
#
# Fine-grained PAT: github.com/settings/personal-access-tokens
#   Resource owner      : kendi hesabın
#   Repository access   : Public Repositories (read-only)
#   Repository perms    : Metadata → Read-only  (otomatik gelir, yeter)
#   Account permissions : hiçbiri
# Bu token PUBLIC veri okur; daha fazla izin verme.
#
# BOŞ BIRAKILABİLİR: token yoksa getGitHub() fallback'e düşer ve site
# featured-projects.ts ile render eder. Kart asla boş kalmaz.
GITHUB_TOKEN=
GITHUB_USERNAME=agunduuz
#
# Push webhook'unun x-hub-signature-256 imzası için. Üret:
#   openssl rand -hex 32
# Yalnızca /api/revalidate ucu kullanır; yereldeyken gerekmez.
# Değiştirirsen GitHub webhook ayarında da güncelle — iki yerde birden
# değişmezse webhook sessizce 401 döner.
GITHUB_WEBHOOK_SECRET=

# Faz 6 — Formlar (şimdilik gerekmez)
RESEND_API_KEY=
# İş teklifi ve abonelik bildirimlerinin gideceği adres.
CONTACT_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
